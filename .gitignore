# 저장소에 올리는 것: 정리기 화면 · rules/ · data/ 의 예시 파일 · README · 정리/ 의 정리 스크립트(코드만)

# 배포 · 실행 부산물
.vercel/
node_modules/
__pycache__/
.env
.env.*

# 정답(tools/answer/)은 어디에도 올리지 않는다. tools/check.js 도 저장소에 넣지 않기로 했다
tools/

# 스크립트(정리/정리_상담원장.py)를 돌리면 다시 나오는 결과
정리본/

# 진단 기록
진단/

# Claude 설정 · 스킬 — 저장소에 넣지 않기로 했다
.claude/

# csv · xlsx 는 data/ 의 예시 파일만
*.csv
*.xlsx
!data/*.csv
!data/*.xlsx

# 고객번호 · 고객명이 들어 있는 원본 — data/ 안에 있어도 뺀다
data/상담원장_2025.xlsx
